# PostgreSQL Database
POSTGRES_DB=smart_home
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# InfluxDB
DOCKER_INFLUXDB_INIT_PASSWORD=CHANGE_ME_INFLUX_PASSWORD
INFLUXDB_TOKEN=CHANGE_ME_INFLUX_TOKEN_64_CHARS_MINIMUM

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# MQTT Broker
MQTT_USER=smart_home_user
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD

# JWT Secret (Must be at least 32 characters, use: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS

# Frontend URL (Change to your domain in production)
FRONTEND_URL=https://your-domain.com

# Grafana Admin Password
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
