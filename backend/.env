PORT=3000
NODE_ENV=production
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_STRING_MIN_32_CHARS_PROD
FRONTEND_URL=https://your-domain.com

# --- Database (PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_SECURE_DB_PASSWORD_123!@#
DB_NAME=smart_home
DATABASE_URL=postgresql://postgres:CHANGE_THIS_SECURE_DB_PASSWORD_123!@#@postgres:5432/smart_home

# --- InfluxDB ---
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=admin_token_change_in_prod
INFLUXDB_ORG=smart-home
INFLUXDB_BUCKET=iot-data

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- MQTT ---
MQTT_BROKER=mqtt://mosquitto:1883
MQTT_USER=smart_home_user
MQTT_PASSWORD=CHANGE_THIS_MQTT_PASSWORD
