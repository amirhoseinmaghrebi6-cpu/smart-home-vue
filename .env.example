# ---------------------------------------------------------
# Smart Home Production Environment Configuration
# Domain: m2smart.ir
# ---------------------------------------------------------

# --- General ---
NODE_ENV=production
DOMAIN=m2smart.ir
TZ=Asia/Tehran

# --- Database (PostgreSQL) ---
POSTGRES_USER=smarthome_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=smarthome_db
DATABASE_URL=postgresql://smarthome_admin:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres:5432/smarthome_db

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASS
REDIS_URL=redis://default:CHANGE_ME_REDIS_PASS@redis:6379

# --- JWT & Security ---
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS_RANDOM
TOKEN_COOKIE_NAME=sh_access_token
# Session expiry in seconds (e.g., 1 day)
JWT_EXPIRY=86400

# --- MQTT (Mosquitto) ---
# Credentials for internal services (backend)
MQTT_INTERNAL_USER=backend_service
MQTT_INTERNAL_PASS=CHANGE_ME_MQTT_INTERNAL_PASS
# Note: Device credentials should be managed per-device in production
MOSQUITTO_PASSWORD=CHANGE_ME_MQTT_ADMIN_PASS

# --- Backend ---
PORT=3000
CORS_ORIGIN=https://m2smart.ir

# --- Frontend ---
VITE_API_BASE_URL=https://m2smart.ir/api
VITE_WS_URL=wss://m2smart.ir

# --- SSL Paths (Let's Encrypt) ---
SSL_CERT_PATH=/etc/letsencrypt/live/m2smart.ir/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/m2smart.ir/privkey.pem

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASS

# --- Portainer ---
PORTAINER_ADMIN_PASSWORD=CHANGE_ME_PORTAINER_PASS
