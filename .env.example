# Database
POSTGRES_USER=smarthome_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=smarthome_db
DATABASE_URL=postgresql://smarthome_user:CHANGE_ME_DB_PASSWORD@postgres:5432/smart_home_db

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://default:CHANGE_ME_REDIS_PASSWORD@redis:6379

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# MQTT
MQTT_HOST=mqtt.m2smart.ir
MQTT_PORT=8883
MQTT_INTERNAL_PASS=CHANGE_ME_MQTT_INTERNAL_PASS
MQTT_PROTOCOL=wss

# Backend
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://m2smart.ir

# Frontend
VITE_API_URL=https://m2smart.ir/api
VITE_WS_URL=wss://m2smart.ir

# SSL Paths (on host)
SSL_CERT_PATH=/etc/letsencrypt/live/m2smart.ir/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/m2smart.ir/privkey.pem