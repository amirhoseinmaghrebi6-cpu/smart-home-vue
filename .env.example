# Frontend Environment Variables Example
# Copy to .env.development or .env.production and update values

# Development: use /api (Vite proxy → backend)
VITE_API_BASE_URL=/api

# Production: use your server domain
# VITE_API_BASE_URL=https://yourdomain.ir/api

# App metadata
VITE_APP_NAME=Smart Home
VITE_APP_VERSION=1.0.0
